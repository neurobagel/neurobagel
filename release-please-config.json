  "tag-separator": "-",
  "include-commit-authors": true,
  "packages": {
    "recipes": {
      "release-type": "simple",
      "component": "recipes"
    },
    "tools/api": {
      "release-type": "simple",
      "component": "api"
    },
    "tools/federation-api": {
      "release-type": "simple",
      "component": "federation-api"
    },
    "tools/query-tool": {
      "release-type": "node",
      "component": "query-tool"
    },
    "tools/configure-nb": {
      "release-type": "simple",
      "component": "configure-nb"
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "🚀 Enhancements" },
    { "type": "patch", "section": "🚀 Enhancements" },
    { "type": "fix", "section": "🐛 Bug Fixes" },
    { "type": "perf", "section": "🏎 Performance Improvements" },
    { "type": "revert", "section": "↩️ Reverts" },
    { "type": "docs", "section": "📝 Documentation", "hidden": true },
    { "type": "deps", "section": "🔩 Dependency Updates" },
    { "type": "test", "section": "🧪 Tests", "hidden": true },
    { "type": "style", "section": "Styles", "hidden": true },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true }
  ]
}
