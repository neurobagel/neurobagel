+++ b/.github/pull_request_template.md
@@ -0,0 +1,34 @@
+<!--
+PR title: a conventional commit, used as the squash commit message and by release-please:
+  <type>[(<scope>)][!]: <description>
+  type: feat, fix, perf, revert (release), or refactor, docs, test, chore, ci, build, style (no release)
+  scope (optional): api, federation-api, query-tool, configure-nb, recipes, examples
+  "!" marks a breaking change.
+
+A PR that changes more than one tool and should release several of them: use a
+non-releasing title (chore:, ci:, ...), make one conventional commit per tool (each
+touching only that tool), and merge with a MERGE COMMIT. See DEVELOPING.md.
+Never write the release-please override marker literally in this description; escape it as
+BEGIN\_COMMIT\_OVERRIDE when you mention it.
+-->
+
+- Closes #
+
+Changes proposed in this pull request:
+
+-
+
+## Checklist
+_This section is for the PR reviewer_
+
+- [ ] PR title is a conventional commit with the right type (it decides the release)
+- [ ] Multi-tool PR that releases: one conventional commit per tool, non-releasing title, merge with a merge commit
+- [ ] PR links to a GitHub issue with `Closes #XXXX`
+- [ ] Tests pass
+- [ ] Checks pass
+
+For new features:
+- [ ] Tests have been added
+
+For bug fixes:
+- [ ] There is at least one test that would fail under the original bug conditions.
diff --git a/.github/workflows/pr-checks.yml b/.github/workflows/pr-checks.yml
new file mode 100644
index 00000000..28f404a7
--- /dev/null
+++ b/.github/workflows/pr-checks.yml
@@ -0,0 +1,44 @@
+name: pr checks
+
+# PRs are squash-merged with the PR title as the commit message, and release-please reads
+# the commit messages: the title must be a conventional commit. Multi-tool PRs follow the
+# merge convention in DEVELOPING.md, checked at review.
+on:
+  pull_request:
+    types: [opened, edited, synchronize, reopened]
+
+permissions:
+  contents: read
+
+jobs:
+  pr-title:
+    runs-on: ubuntu-latest
+    permissions:
+      pull-requests: read
+    steps:
+      - name: Check the PR title
+        uses: amannn/action-semantic-pull-request@v6
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        with:
+          types: |
+            feat
+            fix
+            perf
+            revert
+            docs
+            style
+            refactor
+            test
+            build
+            ci
+            chore
+          # tools, recipes, examples; deps for Dependabot
+          scopes: |
+            api
+            federation-api
+            query-tool
+            configure-nb
+            recipes
+            examples
+            deps
diff --git a/.pre-commit-config.yaml b/.pre-commit-config.yaml
new file mode 100644
index 00000000..442938f4
--- /dev/null
+++ b/.pre-commit-config.yaml
@@ -0,0 +1,191 @@
+# Root pre-commit configuration of the monorepo. Install once at the root:
+#   pre-commit install   (installs the pre-commit and post-merge hooks)
+#
+# The hooks are the tools' own hooks, defined here once and scoped to each tool's folder
+# (`files:`), with the tool's config file passed explicitly, because pre-commit runs hooks
+# from the repository root. Hook versions are the ones the tools use upstream. The tools'
+# own .pre-commit-config.yaml files stay in their folders unchanged: they are the old
+# repositories' configs during the monorepo trial, and are not used here.
+default_install_hook_types: [pre-commit, post-merge]
+default_stages: [pre-commit]
+
+ci:
+  autofix_prs: false
+  autoupdate_commit_msg: "chore: pre-commit autoupdate"
+  # Need Docker or query-tool's node_modules, which pre-commit.ci does not have. query-tool's
+  # lint and format checks also run in its CI workflow.
+  skip:
+    - docker-compose-check
+    - query-tool-typecheck
+    - query-tool-lint
+    - query-tool-format
+    - query-tool-npm-ci-after-merge
+
+repos:
+  # --- Python formatting and linting (api, federation-api, configure-nb) ------------------
+  - repo: https://github.com/psf/black-pre-commit-mirror
+    rev: 26.10.1
+    hooks:
+      - id: black
+        alias: black-api
+        files: ^tools/api/
+        args: [--config=tools/api/pyproject.toml]
+      - id: black
+        alias: black-federation-api
+        files: ^tools/federation-api/
+        args: [--config=tools/federation-api/pyproject.toml]
+      - id: black
+        alias: black-configure-nb
+        files: ^tools/configure-nb/
+        args: [--config=tools/configure-nb/pyproject.toml]
+
+  - repo: https://github.com/PyCQA/flake8
+    rev: 7.5.0
+    hooks:
+      - id: flake8
+        alias: flake8-api
+        files: ^tools/api/
+        args: [--config=tools/api/.flake8]
+      - id: flake8
+        alias: flake8-federation-api
+        files: ^tools/federation-api/
+        # federation-api passes its flake8 settings on the command line (no config file)
+        args:
+          - --extend-ignore=E501
+          - --extend-select=B950
+          - --per-file-ignores=./tools/federation-api/app/api/models.py:F722
+      - id: flake8
+        alias: flake8-configure-nb
+        files: ^tools/configure-nb/
+        args: [--config=tools/configure-nb/.flake8]
+
+  - repo: https://github.com/pre-commit/pre-commit-hooks
+    rev: v6.0.0
+    hooks:
+      - id: check-yaml
+        alias: check-yaml-python-tools
+        files: ^tools/(api|federation-api|configure-nb)/
+      - id: check-toml
+        alias: check-toml-api-configure-nb
+        files: ^tools/(api|configure-nb)/
+      - id: pretty-format-json
+        alias: pretty-format-json-api
+        files: ^tools/api/
+        args: [--autofix, --no-sort-keys]
+
+  - repo: https://github.com/pycqa/isort
+    rev: 10.0.0b3
+    hooks:
+      # --settings-path only, never --src (resolved relative to the settings file)
+      - id: isort
+        alias: isort-api
+        files: ^tools/api/
+        args: [--settings-path=tools/api/pyproject.toml]
+      - id: isort
+        alias: isort-federation-api
+        files: ^tools/federation-api/
+        args: [--settings-path=tools/federation-api/pyproject.toml]
+      - id: isort
+        alias: isort-configure-nb
+        files: ^tools/configure-nb/
+        args: [--settings-path=tools/configure-nb/pyproject.toml]
+
+  - repo: https://github.com/codespell-project/codespell
+    rev: v2.4.3
+    hooks:
+      - id: codespell
+        alias: codespell-api
+        files: ^tools/api/
+        additional_dependencies: [tomli]
+        args: [--config=tools/api/.codespellrc, --toml=tools/api/pyproject.toml]
+      - id: codespell
+        alias: codespell-federation-api
+        files: ^tools/federation-api/
+      - id: codespell
+        alias: codespell-configure-nb
+        files: ^tools/configure-nb/
+        additional_dependencies: [tomli]
+        args: [--toml=tools/configure-nb/pyproject.toml]
+      # query-tool ran codespell in CI upstream; here it runs with the other hooks. Its
+      # .codespellrc `skip` globs do not match the paths pre-commit passes, so the same
+      # files are excluded here.
+      - id: codespell
+        alias: codespell-query-tool
+        files: ^tools/query-tool/
+        exclude: ^tools/query-tool/(package-lock\.json$|\.codespellrc$)|\.css$
+        args: [--config=tools/query-tool/.codespellrc]
+
+  - repo: https://github.com/iamthefij/docker-pre-commit
+    rev: v3.0.1
+    hooks:
+      - id: docker-compose-check
+        files: ^tools/api/docker-compose\.yml$
+
+  - repo: https://github.com/pre-commit/mirrors-mypy
+    rev: v2.4.1
+    hooks:
+      - id: mypy
+        alias: mypy-api
+        files: ^tools/api/
+        additional_dependencies: [pydantic]
+        args: [--config-file=tools/api/pyproject.toml]
+      - id: mypy
+        alias: mypy-configure-nb
+        files: ^tools/configure-nb/
+        additional_dependencies: [pydantic, typer]
+        args: [--config-file=tools/configure-nb/pyproject.toml]
+
+  # --- GitHub configuration --------------------------------------------------------------
+  - repo: https://github.com/python-jsonschema/check-jsonschema
+    rev: 0.39.0
+    hooks:
+      - id: check-github-workflows
+        alias: check-github-workflows-federation-api
+        files: ^tools/federation-api/\.github/workflows/[^/]+$
+      - id: check-github-workflows
+        alias: check-github-workflows-root
+      - id: check-dependabot
+
+  # --- query-tool (upstream husky + lint-staged) -------------------------------------------
+  # lint-staged ran typecheck and lint on staged ts/tsx files and format:check on any staged
+  # file, each over the whole tool. Needs `npm ci` in tools/query-tool.
+  - repo: local
+    hooks:
+      - id: query-tool-typecheck
+        name: query-tool typecheck
+        language: system
+        entry: npm --prefix tools/query-tool run typecheck
+        files: ^tools/query-tool/.*\.(ts|tsx)$
+        pass_filenames: false
+      - id: query-tool-lint
+        name: query-tool lint
+        language: system
+        entry: npm --prefix tools/query-tool run lint:check
+        files: ^tools/query-tool/.*\.(ts|tsx)$
+        pass_filenames: false
+      - id: query-tool-format
+        name: query-tool format check
+        language: system
+        entry: npm --prefix tools/query-tool run format:check
+        files: ^tools/query-tool/
+        pass_filenames: false
+      # Upstream husky post-merge hook: reinstall query-tool's dependencies when its
+      # package.json changed in the merge.
+      - id: query-tool-npm-ci-after-merge
+        name: query-tool npm ci after merge
+        language: system
+        entry: bash -c 'git diff --quiet ORIG_HEAD HEAD -- tools/query-tool/package.json || npm --prefix tools/query-tool ci'
+        stages: [post-merge]
+        always_run: true
+        pass_filenames: false
+
+  # --- configs shared by several tools: shared/ -> the copies listed in shared/files.yaml --
+  - repo: local
+    hooks:
+      - id: sync-shared
+        name: shared configs copied into the tools
+        language: python
+        additional_dependencies: [pyyaml==6.0.3]
+        entry: python scripts/sync-shared.py
+        always_run: true
+        pass_filenames: false
diff --git a/scripts/sync-shared.py b/scripts/sync-shared.py
new file mode 100755
index 00000000..f3d0a8b0
--- /dev/null
+++ b/scripts/sync-shared.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Copy the shared configs in shared/ into the tool folders, as listed in shared/files.yaml.
+
+Usage (from anywhere in the repository; needs PyYAML):
+  sync-shared.py           write every copy that differs from its source; exit 1 if any did
+  sync-shared.py --check   only report copies that differ; exit 1 if any do
+
+Runs as a commit hook (root .pre-commit-config.yaml): a commit that changes a source
+gets its copies updated, to be added to the commit. A copy edited by hand is overwritten.
+"""
+
+import argparse
+import os
+import subprocess
+import sys
+
+import yaml
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--check", action="store_true", help="report differences, write nothing")
+    opts = ap.parse_args()
+
+    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True,
+                          check=True).stdout.strip()
+    with open(os.path.join(root, "shared", "files.yaml"), encoding="utf-8") as f:
+        entries = yaml.safe_load(f) or []
+
+    problems, changed = [], []
+    for entry in entries:
+        source = entry["source"]
+        if not source.startswith("shared/"):
+            problems.append(f"{source}: sources must be in shared/")
+            continue
+        try:
+            with open(os.path.join(root, source), "rb") as f:
+                content = f.read()
+        except FileNotFoundError:
+            problems.append(f"{source}: missing")
+            continue
+        for copy in entry.get("copies") or []:
+            if not copy.startswith("tools/"):
+                problems.append(f"{copy}: copies must be inside a tool folder")
+                continue
+            path = os.path.join(root, copy)
+            current = open(path, "rb").read() if os.path.exists(path) else None
+            if current == content:
+                continue
+            changed.append(copy)
+            if not opts.check:
+                os.makedirs(os.path.dirname(path), exist_ok=True)
+                with open(path, "wb") as f:
+                    f.write(content)
+
+    for p in problems:
+        print(f"error: {p}")
+    verb = "differs from" if opts.check else "updated from"
+    for c in changed:
+        print(f"{c}: {verb} its source in shared/")
+    return 1 if problems or changed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/shared/files.yaml b/shared/files.yaml
new file mode 100644
index 00000000..a2dc0774
--- /dev/null
+++ b/shared/files.yaml
@@ -0,0 +1,9 @@
+# Configs shared by several tools: each source file in shared/ is copied to every path in
+# `copies` (inside the tool folders) by scripts/sync-shared.py, which runs as a commit hook
+# and in CI. Edit the source, never a copy. The copies are committed, so each tool folder
+# stays self-contained (and its old repository gets them through the mirror).
+#
+# - source: shared/<file>
+#   copies:
+#     - tools/<tool>/<file>
+[]
