@@ -0,0 +1,76 @@
+name: docker nightly query-tool (reusable)
+
+# The `nightly` image of query-tool, as upstream's build_docker_nightly.yml in query-tool:
+# amd64 only, and the app's version (package.json) marks the build:
+# <version>-dev-<short sha>. Called by tool-query-tool.yml on push to main after its tests
+# pass. Registry and namespace: repository variables IMAGE_REGISTRY and IMAGE_NAMESPACE.
+on:
+  workflow_call:
+
+permissions:
+  contents: read
+  packages: write
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check registry configuration
+        env:
+          REGISTRY: ${{ vars.IMAGE_REGISTRY }}
+          NAMESPACE: ${{ vars.IMAGE_NAMESPACE }}
+        run: |
+          if [ -z "$REGISTRY" ] || [ -z "$NAMESPACE" ]; then
+            echo "::error::Set the repository variables IMAGE_REGISTRY and IMAGE_NAMESPACE"; exit 1
+          fi
+
+      - name: Checkout
+        uses: actions/checkout@v7
+        with:
+          persist-credentials: false
+
+      # The tool's symlinks into recipes/ and examples/ (former submodules) would dangle
+      # inside the build context. Replace them with copies, as upstream's build context had
+      # the submodule contents.
+      - name: Materialize symlinks in the build context
+        working-directory: tools/query-tool
+        run: |
+          git ls-files -s . | awk '$1=="120000" {print $4}' | while read -r link; do
+            target="$(readlink -f "$link")"
+            rm "$link"
+            cp -R "$target" "$link"
+            echo "materialized $link"
+          done
+
+      - name: Update package.json version
+        working-directory: tools/query-tool
+        run: |
+          BASE=$(npm pkg get version | tr -d '"')
+          npm pkg set version="${BASE}-dev-${GITHUB_SHA::7}"
+          npm pkg get version
+
+      - name: Login to Docker Hub
+        if: vars.IMAGE_REGISTRY == 'docker.io'
+        uses: docker/login-action@v4
+        with:
+          username: ${{ secrets.DOCKERHUB_USERNAME }}
+          password: ${{ secrets.DOCKERHUB_TOKEN }}
+
+      - name: Login to ghcr
+        if: vars.IMAGE_REGISTRY == 'ghcr.io'
+        uses: docker/login-action@v4
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Set up Docker Buildx
+        uses: docker/setup-buildx-action@v4
+
+      - name: Build and push
+        uses: docker/build-push-action@v7
+        with:
+          context: tools/query-tool
+          file: tools/query-tool/Dockerfile
+          push: true
+          tags: ${{ vars.IMAGE_REGISTRY }}/${{ vars.IMAGE_NAMESPACE }}/query_tool:nightly
