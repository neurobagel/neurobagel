index 00000000..f9bddbcb
--- /dev/null
+++ b/.github/workflows/reusable-docker-release.yml
@@ -0,0 +1,98 @@
+name: docker release (reusable)
+
+# The release images v<version> and latest of one tool (api, federation-api, query-tool),
+# built from its own folder with its Dockerfile, as upstream's build_docker_on_release.yml.
+# Called by release.yml for each tool that release-please released. Registry and
+# namespace: repository variables IMAGE_REGISTRY and IMAGE_NAMESPACE.
+on:
+  workflow_call:
+    inputs:
+      tool:
+        description: Tool folder name under tools/ (the build context)
+        required: true
+        type: string
+      image:
+        description: Image name (e.g. api, federation_api, query_tool)
+        required: true
+        type: string
+      version:
+        description: Released version (X.Y.Z); the image tags are vX.Y.Z and latest
+        required: true
+        type: string
+
+permissions:
+  contents: read
+  packages: write
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check registry configuration
+        env:
+          REGISTRY: ${{ vars.IMAGE_REGISTRY }}
+          NAMESPACE: ${{ vars.IMAGE_NAMESPACE }}
+        run: |
+          if [ -z "$REGISTRY" ] || [ -z "$NAMESPACE" ]; then
+            echo "::error::Set the repository variables IMAGE_REGISTRY and IMAGE_NAMESPACE"; exit 1
+          fi
+
+      - name: Checkout
+        uses: actions/checkout@v7
+        with:
+          persist-credentials: false
+
+      # The tool's symlinks into recipes/ and examples/ (former submodules) would dangle
+      # inside the build context. Replace them with copies, as upstream's build context had
+      # the submodule contents.
+      - name: Materialize symlinks in the build context
+        working-directory: tools/${{ inputs.tool }}
+        run: |
+          git ls-files -s . | awk '$1=="120000" {print $4}' | while read -r link; do
+            target="$(readlink -f "$link")"
+            rm "$link"
+            cp -R "$target" "$link"
+            echo "materialized $link"
+          done
+
+      # OCI labels (created, revision, version) as upstream's release images had them
+      - name: Docker meta
+        id: meta
+        uses: docker/metadata-action@v6
+        with:
+          images: ${{ vars.IMAGE_REGISTRY }}/${{ vars.IMAGE_NAMESPACE }}/${{ inputs.image }}
+          tags: |
+            type=raw,value=v${{ inputs.version }}
+            type=raw,value=latest
+          flavor: latest=false
+
+      - name: Login to Docker Hub
+        if: vars.IMAGE_REGISTRY == 'docker.io'
+        uses: docker/login-action@v4
+        with:
+          username: ${{ secrets.DOCKERHUB_USERNAME }}
+          password: ${{ secrets.DOCKERHUB_TOKEN }}
+
+      - name: Login to ghcr
+        if: vars.IMAGE_REGISTRY == 'ghcr.io'
+        uses: docker/login-action@v4
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Set up Docker Buildx
+        uses: docker/setup-buildx-action@v4
+
+      - name: Build and push
+        uses: docker/build-push-action@v7
+        with:
+          platforms: linux/arm64, linux/amd64
+          context: tools/${{ inputs.tool }}
+          file: tools/${{ inputs.tool }}/Dockerfile
+          push: true
+          tags: ${{ steps.meta.outputs.tags }}
+          labels: |
+            org.opencontainers.image.created=${{ fromJSON(steps.meta.outputs.json).labels['org.opencontainers.image.created'] }}
+            org.opencontainers.image.revision=${{ fromJSON(steps.meta.outputs.json).labels['org.opencontainers.image.revision'] }}
+            org.opencontainers.image.version=${{ fromJSON(steps.meta.outputs.json).labels['org.opencontainers.image.version'] }}
